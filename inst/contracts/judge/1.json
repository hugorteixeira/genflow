{
  "id": "judge",
  "version": 1,
  "kind": "workflow",
  "arguments": {
    "type": "object",
    "properties": {
      "agent_version_id": {
        "type": "string",
        "pattern": "\\S",
        "x-ui": {
          "hidden": true
        }
      },
      "agent_version_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        },
        "minItems": 1,
        "maxItems": 1
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1,
        "default": 1
      },
      "on_failure": {
        "type": "string",
        "enum": [
          "pause",
          "abstain"
        ],
        "default": "pause",
        "title": "Se este juiz falhar"
      },
      "policy": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "majority",
              "plurality"
            ],
            "default": "majority",
            "title": "Regra da votação"
          },
          "quorum": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 1,
            "title": "Mínimo de votos válidos"
          }
        },
        "required": [],
        "additionalProperties": false,
        "default": {}
      },
      "agent_drafts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "object",
          "required": [
            "agent"
          ],
          "properties": {
            "agent": {
              "type": "object"
            },
            "prompt": {
              "type": "object",
              "properties": {
                "template": {
                  "type": "string",
                  "pattern": "\\S",
                  "maxLength": 100000
                }
              },
              "required": [
                "template"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "x-ui": {
          "hidden": true
        }
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "port_rule": "judge"
}
