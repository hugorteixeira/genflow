{
  "id": "input",
  "version": 2,
  "kind": "workflow",
  "arguments": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "maxLength": 64,
        "pattern": "\\S",
        "title": "Nome da entrada"
      },
      "kind": {
        "type": "string",
        "enum": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "ballot"
        ],
        "default": "text",
        "title": "Tipo de conteúdo",
        "x-ui": {
          "enum_labels": {
            "text": "Texto",
            "json": "JSON",
            "image": "Imagem",
            "audio": "Áudio",
            "video": "Vídeo",
            "ballot": "Recibo de voto"
          }
        }
      },
      "value_type": {
        "type": "string",
        "enum": [
          "asset",
          "list"
        ],
        "default": "asset",
        "title": "Receber",
        "x-ui": {
          "enum_labels": {
            "asset": "Um conteúdo",
            "list": "Uma lista"
          }
        }
      },
      "output_schema": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true,
        "default": null,
        "x-ui": {
          "hidden": true
        }
      }
    },
    "required": [
      "key"
    ],
    "additionalProperties": false
  },
  "port_rule": "input"
}
