{
  "id": "generate",
  "version": 1,
  "kind": "workflow",
  "arguments": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string",
        "enum": [
          "ai",
          "manual",
          "provided"
        ],
        "default": "ai"
      },
      "kind": {
        "type": "string",
        "enum": [
          "text",
          "json",
          "image",
          "audio",
          "video"
        ],
        "title": "Tipo de conteúdo"
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 32
      },
      "agent_version_id": {
        "type": "string",
        "pattern": "\\S",
        "x-ui": {
          "hidden": true
        }
      },
      "agent_version_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        },
        "minItems": 1,
        "maxItems": 32
      },
      "artifact_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        },
        "maxItems": 32
      },
      "output_schema": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true,
        "default": null,
        "x-ui": {
          "hidden": true
        }
      },
      "agent_drafts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "required": [
            "agent"
          ],
          "properties": {
            "agent": {
              "type": "object"
            },
            "prompt": {
              "type": "object",
              "properties": {
                "template": {
                  "type": "string",
                  "pattern": "\\S",
                  "maxLength": 100000
                }
              },
              "required": [
                "template"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "x-ui": {
          "hidden": true
        }
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "port_rule": "generate"
}
