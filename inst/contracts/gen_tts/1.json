{
  "id": "gen_tts",
  "version": 1,
  "kind": "function",
  "arguments": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "pattern": "\\S",
        "x-content-kind": "text",
        "title": "Texto da fala",
        "x-ui": {
          "hidden": true
        }
      },
      "add": {
        "type": [
          "string",
          "null"
        ],
        "default": null,
        "x-ui": {
          "hidden": true
        }
      },
      "directory": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "\\S",
        "default": null,
        "x-ui": {
          "hidden": true
        }
      },
      "label": {
        "type": [
          "string",
          "null"
        ],
        "default": null,
        "x-ui": {
          "hidden": true
        }
      },
      "service": {
        "type": "string",
        "pattern": "\\S",
        "default": "openai",
        "title": "Serviço",
        "x-ui": {
          "hidden": true
        },
        "maxLength": 100
      },
      "model": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "\\S",
        "default": "gpt-4o-mini-tts",
        "title": "Modelo",
        "x-ui": {
          "hidden": true
        },
        "maxLength": 300,
        "x-default-by": {
          "field": "service",
          "replace": [
            "gpt-4o-mini-tts"
          ],
          "values": {
            "openai": "gpt-4o-mini-tts",
            "replicate": "qwen/qwen3-tts"
          }
        }
      },
      "voice": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "\\S",
        "default": null,
        "title": "Voz"
      },
      "format": {
        "type": "string",
        "enum": [
          "mp3",
          "opus",
          "aac",
          "flac",
          "wav",
          "pcm"
        ],
        "default": "mp3",
        "title": "Formato do áudio"
      },
      "speed": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0.25,
        "maximum": 4,
        "default": 1,
        "title": "Velocidade"
      },
      "instructions": {
        "type": [
          "string",
          "null"
        ],
        "default": null,
        "title": "Instruções para a voz"
      },
      "preview": {
        "type": "boolean",
        "default": false,
        "x-ui": {
          "hidden": true
        }
      },
      "timeout_api": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 240,
        "title": "Tempo máximo da chamada (s)"
      },
      "persist": {
        "type": "boolean",
        "default": true,
        "x-ui": {
          "hidden": true
        }
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "function": "gen_tts",
  "modality": "tts",
  "inputs": {
    "text": "asset:text|asset:json"
  },
  "outputs": {
    "content": "asset:audio"
  },
  "studio": {
    "id": "audio.speak",
    "inputs": {
      "text": "text|json"
    },
    "output": "audio",
    "execution": "inline",
    "available": true
  }
}
